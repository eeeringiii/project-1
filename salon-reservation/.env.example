# ── エルメ（L Message）サロン予約 連携設定 ─────────────────────────────
# コピーして .env.local を作成し、値を設定する（.env.local はコミットしない）。

# 【必須】Webhook 受信の共有シークレット。任意の長いランダム文字列。
# エルメ／Zapier の Webhook URL に ?token=<この値> を付けて送信する。
LME_WEBHOOK_SECRET=

# 連携対象のサロン予約カレンダーID。
# 管理画面URL https://step.lme.jp/basic/calendar-salon/<ここ> の数値。
LME_CALENDAR_ID=24789

# ── アウトバウンドAPI（エルメから能動的にデータ取得する場合のみ）─────────
# ※ エルメのAPI仕様は管理画面ログイン後に要確認。判明したら値を差し替える。
LME_API_BASE_URL=https://step.lme.jp/api
LME_API_TOKEN=
LME_API_RESERVATIONS_PATH=/calendar-salon/{calendarId}/reservations

# ── 永続化（任意）───────────────────────────────────────────────
# 受信イベントを永続バックエンド（KV/DB/別サービス）へ転送する宛先URL。
# 未設定の場合はプロセス内メモリのみ（サーバーレスでは揮発する）。
LME_FORWARD_URL=
