# Claude API (already used by app/api/analyze-food, app/api/feedback)
ANTHROPIC_API_KEY=

# LINE Developers console > your Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Notion integration (https://www.notion.so/my-integrations)
# Share your task database with this integration first.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Must match the property names in your existing Notion task database
# (the one your Notion -> Slack automation already reads from).
NOTION_TITLE_PROPERTY=Name
NOTION_DATE_PROPERTY=
NOTION_NOTES_PROPERTY=
